# =============================================================================
# PautaLimpa — Modelo de Variáveis de Ambiente (Completo — Épicos 0–8)
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env  (Windows: copy .env.example .env)
#   2. Preencha TODOS os valores marcados com "PREENCHER" antes de executar
#   3. NUNCA versione o arquivo .env (já incluído no .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# BANCO DE DADOS — PostgreSQL (obrigatório)
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pauta_limpa
DB_USER=postgres
DB_PASSWORD=PREENCHER

# Alternativa: URL completa (tem prioridade sobre os campos acima)
# DATABASE_URL=postgresql://postgres:SENHA@localhost:5432/pauta_limpa

# -----------------------------------------------------------------------------
# API CÂMARA DOS DEPUTADOS — Dados Abertos (Épico 1)
# Não requer autenticação. Deixe API_KEY vazio.
# Documentação: https://dadosabertos.camara.leg.br/swagger/api.html
# -----------------------------------------------------------------------------
API_BASE_URL=https://dadosabertos.camara.leg.br/api/v2
API_KEY=
API_TIMEOUT_SECONDS=15
API_MAX_RETRIES=3
API_RETRY_BACKOFF_SECONDS=2
API_PAGE_SIZE=100
API_PAGE_DELAY_SECONDS=1.0        # Delay entre páginas (respeitar rate limit)
MAX_PAGES_PER_RUN=3               # Máximo de páginas por execução

# -----------------------------------------------------------------------------
# LLM — OpenAI (Épico 2 — Primário)
# -----------------------------------------------------------------------------
# Para Ollama local, use:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=llama3.2:3b
OPENAI_BASE_URL=
OPENAI_API_KEY=PREENCHER
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3
LLM_TOKEN_INPUT_LIMIT=8000        # Limite seguro para chunking
LLM_MAX_PRIMARY_ATTEMPTS=3        # Tentativas antes de acionar fallback
LLM_RETRY_WAIT_SECONDS=30         # Espera entre retries de 429/5xx

# -----------------------------------------------------------------------------
# LLM — Anthropic Claude (Épico 2 — Fallback)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=PREENCHER
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=1024

# -----------------------------------------------------------------------------
# META / INSTAGRAM — Graph API (Épico 4)
# Obtenha em: https://developers.facebook.com/
# ATENÇÃO: Use conta profissional/business, nunca conta pessoal
# -----------------------------------------------------------------------------
META_ACCESS_TOKEN=PREENCHER
META_IG_USER_ID=PREENCHER         # ID numérico da conta Instagram Business
META_TOKEN_EXPIRY_DATE=2025-12-31 # YYYY-MM-DD — atualizar ao renovar o token

# -----------------------------------------------------------------------------
# PLACID — Geração de Imagens (Épico 4)
# Obtenha em: https://placid.app/
# Templates devem ter dimensões 1080x1350px (retrato Instagram)
# IDs separados por vírgula para A/B testing (Épico 8)
# -----------------------------------------------------------------------------
PLACID_API_KEY=PREENCHER
PLACID_TEMPLATE_IDS=TEMPLATE_ID_A,TEMPLATE_ID_B
PLACID_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# AGENDAMENTO — APScheduler (Épico 3)
# -----------------------------------------------------------------------------
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULE_PUBLISH_HOUR=18          # Horário da publicação principal (pico orgânico)
SCHEDULE_PUBLISH_MINUTE=0
SCHEDULE_METRICS_HOUR=10          # Coleta de métricas (posts de ontem)
SCHEDULE_METRICS_MINUTE=0
SCHEDULE_CLEANUP_HOUR=2           # Limpeza de arquivos (madrugada)
SCHEDULE_BACKUP_HOUR=3            # Backup do banco (madrugada)

# Tamanho dos lotes por execução
PUBLISH_BATCH_SIZE=3              # Máximo de leis publicadas por dia
LLM_BATCH_SIZE=10                 # Máximo de projetos processados por LLM/run

# -----------------------------------------------------------------------------
# ALERTAS — Slack / Telegram / E-mail (Épico 5)
# Configure pelo menos um canal. Todos são opcionais individualmente.
# -----------------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/PREENCHER
TELEGRAM_BOT_TOKEN=PREENCHER
TELEGRAM_CHAT_ID=PREENCHER

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=PREENCHER@gmail.com
SMTP_PASSWORD=PREENCHER           # Use App Password do Gmail (não a senha normal)
ALERT_FROM_EMAIL=PREENCHER@gmail.com
ALERT_TO_EMAILS=email1@exemplo.com,email2@exemplo.com

# FinOps: limite mensal de tokens (dispara alerta em 80%)
MONTHLY_TOKEN_BUDGET=1000000

# -----------------------------------------------------------------------------
# BACKUP — AWS S3 (Épico 6)
# Deixe BACKUP_S3_BUCKET vazio para manter backups apenas locais
# -----------------------------------------------------------------------------
BACKUP_S3_BUCKET=PREENCHER
BACKUP_S3_PREFIX=pautalimpa/backups/
BACKUP_LOCAL_DIR=./backups
BACKUP_DAILY_RETENTION=7          # Manter últimos N backups diários
BACKUP_WEEKLY_RETENTION=4         # Manter 1 backup por semana das últimas N semanas

# AWS Credentials (se usar S3)
AWS_ACCESS_KEY_ID=PREENCHER
AWS_SECRET_ACCESS_KEY=PREENCHER
AWS_DEFAULT_REGION=us-east-1

# -----------------------------------------------------------------------------
# AUDITORIA (Épico 6)
# -----------------------------------------------------------------------------
AUDIT_SYSTEM_USER=pipeline_automatico  # Usuário gravado em ações automáticas

# -----------------------------------------------------------------------------
# LOGS E AMBIENTE
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_DIR=./logs
LOG_RETENTION_DAYS=30             # Remover logs com mais de N dias
AUDIT_ARCHIVE_DAYS=90             # Arquivar registros de auditoria com mais de N dias
ENVIRONMENT=development           # development | staging | production
